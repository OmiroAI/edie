# Copy to private .env; never commit real values.
EDIE_MEDIA=/absolute/path/to/authorised/media
EDIE_STATE=/absolute/path/to/private/state
EDIE_API_TOKEN=replace-with-a-long-random-private-token
EDIE_PORT=8080

EDIE_CONFIG_DIR=/absolute/path/to/private/config
# Match the owner of private state/config directories.
EDIE_UID=10001
EDIE_GID=10001
