# Copy to private .env; never commit real values.
EDIE_MEDIA=/absolute/path/to/authorised/media
EDIE_STATE=/absolute/path/to/private/state
EDIE_API_TOKEN=replace-with-a-long-random-private-token
EDIE_PORT=8080

EDIE_CONFIG_DIR=/absolute/path/to/private/config
# Match the owner of private state/config directories.
EDIE_UID=10001
EDIE_GID=10001

# Optional agent/index services; all paths must exist before starting containers.
EDIE_ROUTES_FILE=/absolute/path/to/private/container-routes.json
EDIE_MANIFEST_FILE=/absolute/path/to/private/broker-manifest.json
EDIE_CODEX_SOCKET=/absolute/path/to/private/codex.sock
EDIE_MODEL_SOCKET=/absolute/path/to/private/models.sock
